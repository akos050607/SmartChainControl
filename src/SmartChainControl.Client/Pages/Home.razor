@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@using SmartChainControl.Shared.Models
@inject IJSRuntime JS
@inject NavigationManager NavManager
@implements IAsyncDisposable

<PageTitle>SmartChainControl - Command Center</PageTitle>

<canvas id="renderCanvas"></canvas>

<div class="ui-layer">
    <div class="hud-panel top-bar">
        <div style="font-size: 1.5rem; font-weight: bold; color: #fff; letter-spacing: 2px;">
            <span style="color: #00ffff;">SMART</span>WAREHOUSE
        </div>
        
        <div class="stats-container">
            <div class="stat-item">
                <div class="stat-value">@Robots.Count</div>
                <div class="stat-label">Active Units</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" style="color: #ffaa00">@Robots.Count(r => r.HasCargo)</div>
                <div class="stat-label">Tasks Active</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" style="color: #00ff00">ONLINE</div>
                <div class="stat-label">Network</div>
            </div>
        </div>
    </div>

    @if (SelectedRobot != null)
    {
        <div class="hud-panel detail-panel">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 10px;">
                <h3 style="margin:0; color: @SelectedRobot.ColorHex; text-shadow: 0 0 10px @SelectedRobot.ColorHex;">
                    UNIT-@SelectedRobot.Id.ToString("D2")
                </h3>
                <button @onclick="DeselectRobot" style="background:none; border:none; color:#fff; font-size:1.5rem; cursor:pointer; line-height:1;">&times;</button>
            </div>
            
            <button class="mode-btn @(SelectedRobot.State == "Manual" ? "btn-manual" : "btn-auto")" @onclick="ToggleRobotMode">
                @(SelectedRobot.State == "Manual" ? "⚠ RELEASE CONTROL" : "⚡ TAKE CONTROL")
            </button>

            <div style="margin-top: 15px;">
                <div class="detail-row"><span class="detail-key">STATUS</span><span class="detail-val">@SelectedRobot.State.ToUpper()</span></div>
                <div class="detail-row">
                    <span class="detail-key">BATTERY</span>
                    <span class="detail-val" style="color: @GetBatteryColor(SelectedRobot.BatteryLevel)">
                        @SelectedRobot.BatteryLevel.ToString("F1")%
                    </span>
                </div>
                <div class="detail-row"><span class="detail-key">VELOCITY</span><span class="detail-val">1.8 m/s</span></div>
                <div class="detail-row">
                    <span class="detail-key">PAYLOAD</span>
                    <span class="detail-val" style="color: @(SelectedRobot.HasCargo ? "#ffaa00" : "#666")">
                        @(SelectedRobot.HasCargo ? "HEAVY CARGO" : "NO LOAD")
                    </span>
                </div>
                <div class="detail-row"><span class="detail-key">POSITION</span><span class="detail-val">X:@Math.Round(SelectedRobot.X,1) Y:@Math.Round(SelectedRobot.Y,1)</span></div>
            </div>
        </div>
    }
    else
    {
        <div class="hud-panel" style="border: 1px dashed #00ffff; background: rgba(0, 255, 255, 0.05); animation: pulse 2s infinite;">
            <div style="display: flex; align-items: center; gap: 15px;">
                <div style="font-size: 2rem; animation: bounce 1.5s infinite;">👆</div>
                <div>
                    <div style="color: #00ffff; font-weight: bold; letter-spacing: 1px; margin-bottom: 3px;">KÉZI VEZÉRLÉS ELÉRHETŐ</div>
                    <div style="color: #aaa; font-size: 0.9rem;">Kattints egy drónra a 3D nézetben az adatokhoz és az irányítás átvételéhez!</div>
                </div>
            </div>
        </div>
    }

    <div class="hud-panel radar-container">
        <div class="radar-grid"></div>
        @if (CurrentMap != null)
        {
            @foreach (var obs in CurrentMap.Obstacles)
            {
                <div class="map-shelf"
                     style="left: @((obs.X / 20.0 * 100))%;
                            bottom: @((obs.Y / 20.0 * 100))%;
                            width: 5%; height: 5%;
                            background-color: @GetShelfColor(obs.X, obs.Y);">
                </div>
            }
        }
        @for (int i = 0; i < 5; i++)
        {
            string[] colors = new[] { "#FF0000", "#00FF00", "#0000FF", "#FFFF00", "#00FFFF" };
            string color = colors[i % colors.Length];
            int yPos = 2 + (i * 3);
            <div class="map-zone"
                 style="left: 0%;
                        bottom: @((yPos / 20.0 * 100))%;
                        width: 6%; height: 6%;
                        border-color: @color;
                        color: @color;">Z@(i+1)</div>
        }
        @foreach (var robot in Robots)
        {
            <div class="radar-dot"
                 style="left: @((robot.X / 20.0 * 100))%;
                        bottom: @((robot.Y / 20.0 * 100))%;
                        background-color: @robot.ColorHex;"></div>
        }
    </div>
</div>

@code {
    private HubConnection? hubConnection;
    public List<Robot> Robots { get; set; } = new();
    public MapInfo? CurrentMap { get; set; } 
    public Robot? SelectedRobot { get; set; }
    private DotNetObjectReference<Home>? objRef;

    protected override async Task OnInitializedAsync()
    {
        objRef = DotNetObjectReference.Create(this);
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavManager.ToAbsoluteUri("/warehousehub"))
            .AddMessagePackProtocol()
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<List<Robot>>("ReceiveState", (robots) =>
        {
            Robots = robots;
            if (SelectedRobot != null)
            {
                var fresh = Robots.FirstOrDefault(r => r.Id == SelectedRobot.Id);
                if (fresh != null) SelectedRobot = fresh;
            }
            StateHasChanged();
            if (Robots.Count > 0) JS.InvokeVoidAsync("warehouseVisualizer.updateRobots", Robots);
        });

        hubConnection.On<MapInfo>("ReceiveMap", async (map) =>
        {
            CurrentMap = map;
            StateHasChanged(); 
            await JS.InvokeVoidAsync("warehouseVisualizer.createMap", map);
        });

        await hubConnection.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("warehouseVisualizer.init", "renderCanvas", objRef);
    }

    [JSInvokable]
    public async Task SelectRobotFromJS(int robotId)
    {
        if (SelectedRobot != null && SelectedRobot.Id != robotId)
        {
             await hubConnection!.SendAsync("ToggleManualMode", SelectedRobot.Id, false);
        }

        SelectedRobot = Robots.FirstOrDefault(r => r.Id == robotId);
        StateHasChanged();
    }

    private async Task ToggleRobotMode()
    {
        if (SelectedRobot != null && hubConnection is not null)
        {
            bool isCurrentlyManual = SelectedRobot.State == "Manual";
            await hubConnection.SendAsync("ToggleManualMode", SelectedRobot.Id, !isCurrentlyManual);
        }
    }

    private async Task DeselectRobot()
    {
        if (SelectedRobot != null && hubConnection is not null)
        {
            await hubConnection.SendAsync("ToggleManualMode", SelectedRobot.Id, false);
            SelectedRobot = null;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task FloorClickFromJS(int x, int y)
    {
        if (SelectedRobot != null && SelectedRobot.State == "Manual" && hubConnection is not null)
        {
            await hubConnection.SendAsync("ManualMoveCommand", SelectedRobot.Id, x, y);
        }
    }


    private string GetShelfColor(int x, int y)
    {
        var targetingRobot = Robots.FirstOrDefault(r => r.CurrentTargetNode != null && (int)r.CurrentTargetNode.X == x && (int)r.CurrentTargetNode.Y == y);
        return targetingRobot != null ? targetingRobot.ColorHex : "rgba(100, 110, 130, 0.6)";
    }

    private string GetBatteryColor(double level) => level > 50 ? "#00ff00" : (level > 20 ? "#ffaa00" : "#ff0000");

    public async ValueTask DisposeAsync()
    {
        if (SelectedRobot != null && hubConnection != null)
        {
             await hubConnection.SendAsync("ToggleManualMode", SelectedRobot.Id, false);
        }
        objRef?.Dispose();
        if (hubConnection is not null) await hubConnection.DisposeAsync();
    }
}